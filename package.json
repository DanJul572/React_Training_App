{
    "name": "@dandicode/zapp",
    "private": false,
    "version": "0.0.1",
    "type": "module",
    "license": "MIT",
    "scripts": {
        "run:dev": "vite --mode development",
        "run:stage": "vite --mode staging",
        "run:prod": "vite --mode production",
        "build:dev": "tsc -b && vite build --mode development",
        "build:stage": "tsc -b && vite build --mode staging",
        "build:prod": "tsc -b && vite build --mode production",
        "preview:dev": "vite preview --mode development",
        "preview:stage": "vite preview --mode staging",
        "preview:prod": "vite preview --mode production",
        "test": "vitest --mode development",
        "test:coverage": "vitest run --coverage --mode development",
        "test:ui": "vitest --ui --mode development",
        "lint": "eslint . --max-warnings 0",
        "lint:fix": "eslint . --max-warnings 0 --fix",
        "prepare": "husky"
    },
    "dependencies": {
        "@emotion/react": "^11.14.0",
        "@emotion/styled": "^11.14.0",
        "@fontsource/roboto": "^5.1.1",
        "@mui/icons-material": "^6.4.4",
        "@mui/material": "^6.4.4",
        "@mui/x-data-grid": "^7.27.0",
        "@mui/x-tree-view": "^7.26.0",
        "axios": "^1.7.9",
        "path": "^0.12.7",
        "react": "^19.0.0",
        "react-dom": "^19.0.0",
        "react-hook-form": "^7.54.2",
        "react-responsive": "^10.0.0",
        "react-router-dom": "^7.1.5"
    },
    "devDependencies": {
        "@eslint/compat": "^1.2.6",
        "@eslint/eslintrc": "^3.2.0",
        "@eslint/js": "^9.20.0",
        "@testing-library/dom": "^10.4.0",
        "@testing-library/jest-dom": "^6.6.3",
        "@testing-library/react": "^16.2.0",
        "@testing-library/user-event": "^14.6.1",
        "@types/node": "^22.13.4",
        "@types/react": "^19.0.10",
        "@types/react-dom": "^19.0.4",
        "@typescript-eslint/eslint-plugin": "^8.24.1",
        "@typescript-eslint/parser": "^8.24.1",
        "@vitejs/plugin-react-swc": "^3.8.0",
        "@vitest/coverage-v8": "^3.0.5",
        "@vitest/ui": "^3.0.5",
        "eslint": "^9.20.1",
        "eslint-config-prettier": "^10.0.1",
        "eslint-plugin-prettier": "^5.2.3",
        "eslint-plugin-react-hooks": "^5.1.0",
        "eslint-plugin-react-refresh": "^0.4.19",
        "globals": "^15.15.0",
        "husky": "^9.1.7",
